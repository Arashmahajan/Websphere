# ==============================================================================
# WorkSphere Enterprise HCM: Frontend Environment Configuration
#
# NOTE FOR FRONTEND RUNTIME:
# The React client only requires VITE_API_BASE_URL.
# It does NOT connect to PostgreSQL, Redis, Kafka, or utilize JWT secrets directly.
# All backend infrastructure and secrets belong exclusively to the Spring Boot runtime.
# ==============================================================================

# Spring Boot REST API Endpoint for local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1
